# Pulse Backend Environment Variables
# Copy this file to .env and fill in your real values:
#   cp .env.example .env

# Server port (local development only; Vercel sets this automatically)
PORT=3001

# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# Supabase Service Role Key (server-side only — NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter API Key for AI status generation
OPENROUTER_API_KEY=

# Comma-separated list of allowed CORS origins
# For production, use your deployed frontend URL, e.g.:
#   https://pulse-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000